CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_UNICORE=y
# Seeed XIAO ESP32-C6 has 4 MB flash. The IDF default (2 MB) also selects 32 KB MMU pages,
# which espflash's bundled bootloader (64 KB pages) refuses to boot.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y


# Skip legacy driver conflict checks to eliminate deprecation noise
CONFIG_RMT_SKIP_LEGACY_CONFLICT_CHECK=y
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y
CONFIG_PCNT_SKIP_LEGACY_CONFLICT_CHECK=y
CONFIG_GPTIMER_SKIP_LEGACY_CONFLICT_CHECK=y

# Signed OTA updates (ESP-IDF "Require signed app images" without hardware secure boot).
# esp_ota_end() verifies the new image's Secure Boot V2 RSA-3072 signature against the public
# key in the running app's signature block, so update.complete() rejects unsigned or tampered
# images. No eFuses are burned. The running app must itself be signed or it aborts at boot.
# cargo/espflash don't run IDF's signing step, so images are signed with espsecure (README).
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n
